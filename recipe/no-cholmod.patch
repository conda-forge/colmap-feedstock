  private:
-  Eigen::CholmodSupernodalLLT<Eigen::SparseMatrix<double>> supernodal_;
+  Eigen::SimplicialLLT<Eigen::SparseMatrix<double>> supernodal_;
   Eigen::SimplicialLDLT<Eigen::SparseMatrix<double>> ldlt_;
   bool use_ldlt_ = false;
 };
