+inline LightGlueONNXMatchingOptions DefaultAlikedLightGlueMatchingOptions() {
+  LightGlueONNXMatchingOptions options;
+  options.min_score = 0.1;
+  options.model_path = kDefaultAlikedLightGlueFeatureMatcherUri;
+  return options;
+}
